# Copy to .env at the repository root and replace only the values you use.
# Never commit .env or paste real keys into source files.

# Required by the multiroute backend for Ollama Cloud inference.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=replace-with-your-ollama-key
OLLAMA_TEMPERATURE=0.7

# Optional model assignments (defaults are in docker-compose.yml).
# OLLAMA_MODEL_CLASSIFY=gemma4:31b
# OLLAMA_MODEL_SENTIMENT=glm-5.2
# OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
# OLLAMA_MODEL_INTENT=minimax-m3

# Optional Langfuse tracing for the backend.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: used by deepeval-tests as its evaluation judge, not by the app.
OPENAI_API_KEY=

# Optional placeholders for future Hugging Face integrations. This repository
# currently does not call Hugging Face APIs.
HF_TOKEN=
# HUGGINGFACEHUB_API_TOKEN=