# Ollama Cloud API
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_api_key_here
OLLAMA_TEMPERATURE=0.7

# Default per-route Ollama Cloud model assignments. Each route can be overridden.
OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=gpt-oss:20b
OLLAMA_MODEL_SUMMARIZE=gpt-oss:120b
OLLAMA_MODEL_INTENT=nemotron-3-nano:30b

# Other selected models you can assign to any route:
# gpt-oss:120b, gpt-oss:20b, nemotron-3-super, nemotron-3-ultra

# Server
SERVER_PORT=8080

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
OPENAI_API_KEY=sk-proj-xxxxxxx